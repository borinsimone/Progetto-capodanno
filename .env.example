# Public browser configuration. VITE_ values are included in the client build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Private setup values. Never prefix secrets with VITE_. Never commit .env.
SUPABASE_PROJECT_REF=
SUPABASE_INVITE_CODE=

# Server-only EmailJS configuration. Never use VITE_ for any of these values.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
SEND_EMAIL_HOOK_SECRET=
